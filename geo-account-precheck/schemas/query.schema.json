{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Query Matrix",
  "description": "Generated Query Matrix and its real AI observation coverage.",
  "type": "object",
  "required": ["total", "status", "queries", "coverage"],
  "properties": {
    "total": {"type": "integer", "minimum": 0},
    "status": {"type": "string"},
    "queries": {
      "type": "array",
      "items": {"$ref": "#/definitions/query"}
    },
    "coverage": {
      "type": "object",
      "required": ["total", "status", "basis"],
      "properties": {
        "total": {"type": "integer", "minimum": 0},
        "mentioned": {"type": "integer", "minimum": 0},
        "recommended": {"type": "integer", "minimum": 0},
        "correctly_described": {"type": "integer", "minimum": 0},
        "cited": {"type": "integer", "minimum": 0},
        "mention_rate": {"type": ["integer", "null"], "minimum": 0, "maximum": 100},
        "recommendation_rate": {"type": ["integer", "null"], "minimum": 0, "maximum": 100},
        "description_accuracy": {"type": ["integer", "null"], "minimum": 0, "maximum": 100},
        "citation_rate": {"type": ["integer", "null"], "minimum": 0, "maximum": 100},
        "scenario_coverage": {"type": ["integer", "null"], "minimum": 0, "maximum": 100},
        "score": {"type": ["integer", "null"], "minimum": 0, "maximum": 100},
        "status": {"type": "string"},
        "basis": {"type": "string"}
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true,
  "definitions": {
    "query": {
      "type": "object",
      "required": ["query", "intent"],
      "properties": {
        "query": {"type": "string"},
        "intent": {"type": "string"},
        "root": {"type": "string"},
        "scenario": {"type": "string"},
        "industry": {"type": "string"},
        "location": {"type": "string"},
        "demand": {"type": "string"},
        "pain_point": {"type": "string"},
        "business_value": {"type": "integer", "minimum": 0, "maximum": 100},
        "ai_demand": {"type": "integer", "minimum": 0, "maximum": 100},
        "status": {"type": "string"},
        "source": {"type": "string"}
      },
      "additionalProperties": true
    }
  }
}
