{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "GEO Optimization Prescription",
  "type": "object",
  "required": ["company_position", "current_stage", "prescriptions", "next_step", "boundary"],
  "properties": {
    "company_position": {"type": "string"},
    "current_stage": {"type": "string"},
    "prescriptions": {
      "type": "array",
      "minItems": 4,
      "items": {
        "type": "object",
        "required": ["priority", "title", "goal", "problem", "output"],
        "properties": {
          "priority": {"type": "string", "enum": ["P1", "P2"]},
          "title": {"type": "string"},
          "goal": {"type": "string"},
          "problem": {"type": "string"},
          "output": {"type": "string"}
        },
        "additionalProperties": false
      }
    },
    "next_step": {"type": "string"},
    "boundary": {"type": "string"}
  },
  "additionalProperties": false
}
