{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "GEO AI Growth Gap Map",
  "type": "object",
  "required": ["gaps"],
  "properties": {
    "gaps": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["problem", "reason", "impact", "priority"],
        "properties": {
          "problem": {"type": "string"},
          "reason": {"type": "string"},
          "impact": {"type": "string"},
          "priority": {"type": "string", "enum": ["P0", "P1", "P2", "P3"]}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
