{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "GEO EEAT Trust Score",
  "type": "object",
  "required": ["expertise", "experience", "authority", "trust", "total", "missing_assets"],
  "properties": {
    "expertise": {"type": ["integer", "null"], "minimum": 0, "maximum": 25},
    "experience": {"type": ["integer", "null"], "minimum": 0, "maximum": 25},
    "authority": {"type": ["integer", "null"], "minimum": 0, "maximum": 25},
    "trust": {"type": ["integer", "null"], "minimum": 0, "maximum": 25},
    "total": {"type": ["integer", "null"], "minimum": 0, "maximum": 100},
    "missing_assets": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": false
}
