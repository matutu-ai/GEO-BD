{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/matutu-ai/GEO-BD/schemas/diagnostic.schema.json",
  "title": "GEO-BD Standard Diagnostic Contract",
  "description": "Canonical GEO-BD contract. The internal evidence chain is private; report_projection is the only one-page user-facing result. GEO execution artifacts are outside this contract.",
  "type": "object",
  "required": [
    "contract_version",
    "meta",
    "facts",
    "evidence_verification",
    "diagnostic_measurements",
    "judgments",
    "root_causes",
    "prescriptions",
    "report_projection"
  ],
  "properties": {
    "contract_version": {"type": "string", "enum": ["1.0.0"]},
    "meta": {
      "type": "object",
      "required": ["diagnostic_id", "engine", "generated_at", "status"],
      "properties": {
        "diagnostic_id": {"type": "string", "minLength": 1},
        "engine": {"type": "string", "enum": ["GEO-BD"]},
        "generated_at": {"type": "string", "minLength": 1},
        "status": {"$ref": "#/definitions/status"},
        "input_snapshot_id": {"type": ["string", "null"]},
        "notes": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": false
    },
    "facts": {"type": "array", "items": {"$ref": "#/definitions/fact"}},
    "evidence_verification": {
      "type": "array",
      "items": {"$ref": "#/definitions/evidence_verification"}
    },
    "diagnostic_measurements": {
      "type": "array",
      "items": {"$ref": "#/definitions/diagnostic_measurement"}
    },
    "judgments": {"type": "array", "items": {"$ref": "#/definitions/judgment"}},
    "root_causes": {"type": "array", "items": {"$ref": "#/definitions/root_cause"}},
    "prescriptions": {"type": "array", "items": {"$ref": "#/definitions/prescription"}},
    "report_projection": {"$ref": "#/definitions/report_projection"}
  },
  "additionalProperties": false,
  "definitions": {
    "status": {
      "type": "string",
      "enum": [
        "VERIFIED",
        "OBSERVED",
        "PROVIDED",
        "INFERRED",
        "UNKNOWN",
        "NOT_RUN",
        "INSUFFICIENT_DATA"
      ]
    },
    "source_id": {"type": "string", "minLength": 1},
    "fact": {
      "type": "object",
      "required": ["id", "subject", "predicate", "value", "status", "source_ids"],
      "properties": {
        "id": {"type": "string", "pattern": "^FACT-[A-Za-z0-9._-]+$"},
        "subject": {"type": "string", "minLength": 1},
        "predicate": {"type": "string", "minLength": 1},
        "value": {"type": ["string", "number", "integer", "boolean", "array", "object", "null"]},
        "status": {"type": "string", "enum": ["VERIFIED", "OBSERVED", "PROVIDED", "UNKNOWN"]},
        "source_ids": {
          "type": "array",
          "items": {"$ref": "#/definitions/source_id"},
          "uniqueItems": true
        },
        "observed_at": {"type": ["string", "null"]},
        "notes": {"type": ["string", "null"]}
      },
      "allOf": [
        {
          "if": {"properties": {"status": {"enum": ["UNKNOWN"]}}},
          "then": {"properties": {"value": {"type": "null"}}}
        },
        {
          "if": {"properties": {"status": {"enum": ["VERIFIED", "OBSERVED", "PROVIDED"]}}},
          "then": {"properties": {"source_ids": {"minItems": 1}}}
        }
      ],
      "additionalProperties": false
    },
    "evidence_verification": {
      "type": "object",
      "required": ["id", "fact_id", "status", "method", "source_ids", "conclusion"],
      "properties": {
        "id": {"type": "string", "pattern": "^EVID-[A-Za-z0-9._-]+$"},
        "fact_id": {"type": "string", "pattern": "^FACT-[A-Za-z0-9._-]+$"},
        "status": {"type": "string", "enum": ["VERIFIED", "UNKNOWN", "NOT_RUN", "INSUFFICIENT_DATA"]},
        "method": {"type": "string", "minLength": 1},
        "source_ids": {
          "type": "array",
          "items": {"$ref": "#/definitions/source_id"},
          "uniqueItems": true
        },
        "conclusion": {"type": ["string", "null"]},
        "conflicts": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": false
    },
    "diagnostic_measurement": {
      "type": "object",
      "required": ["id", "name", "value", "unit", "status", "fact_ids", "evidence_ids", "basis"],
      "properties": {
        "id": {"type": "string", "pattern": "^METRIC-[A-Za-z0-9._-]+$"},
        "name": {"type": "string", "minLength": 1},
        "value": {"type": ["number", "integer", "string", "boolean", "null"]},
        "unit": {"type": ["string", "null"]},
        "status": {"$ref": "#/definitions/status"},
        "fact_ids": {
          "type": "array",
          "items": {"type": "string", "pattern": "^FACT-[A-Za-z0-9._-]+$"},
          "uniqueItems": true
        },
        "evidence_ids": {
          "type": "array",
          "items": {"type": "string", "pattern": "^EVID-[A-Za-z0-9._-]+$"},
          "uniqueItems": true
        },
        "basis": {"type": "string", "minLength": 1}
      },
      "anyOf": [
        {"properties": {"fact_ids": {"minItems": 1}}},
        {"properties": {"evidence_ids": {"minItems": 1}}}
      ],
      "allOf": [
        {
          "if": {"properties": {"status": {"enum": ["UNKNOWN", "NOT_RUN", "INSUFFICIENT_DATA"]}}},
          "then": {"properties": {"value": {"type": "null"}}}
        }
      ],
      "additionalProperties": false
    },
    "judgment": {
      "type": "object",
      "required": ["id", "statement", "status", "source_fact_ids", "source_metric_ids", "basis"],
      "properties": {
        "id": {"type": "string", "pattern": "^JUDGMENT-[A-Za-z0-9._-]+$"},
        "statement": {"type": "string", "minLength": 1},
        "status": {"type": "string", "enum": ["INFERRED"]},
        "source_fact_ids": {
          "type": "array",
          "items": {"type": "string", "pattern": "^FACT-[A-Za-z0-9._-]+$"},
          "uniqueItems": true
        },
        "source_metric_ids": {
          "type": "array",
          "items": {"type": "string", "pattern": "^METRIC-[A-Za-z0-9._-]+$"},
          "uniqueItems": true
        },
        "basis": {"type": "string", "minLength": 1},
        "confidence": {"type": ["number", "null"], "minimum": 0, "maximum": 1}
      },
      "anyOf": [
        {"properties": {"source_fact_ids": {"minItems": 1}}},
        {"properties": {"source_metric_ids": {"minItems": 1}}}
      ],
      "additionalProperties": false
    },
    "root_cause": {
      "type": "object",
      "required": ["id", "statement", "status", "judgment_ids", "basis"],
      "properties": {
        "id": {"type": "string", "pattern": "^ROOT-[A-Za-z0-9._-]+$"},
        "statement": {"type": "string", "minLength": 1},
        "status": {"type": "string", "enum": ["INFERRED"]},
        "judgment_ids": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "pattern": "^JUDGMENT-[A-Za-z0-9._-]+$"},
          "uniqueItems": true
        },
        "basis": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "prescription": {
      "type": "object",
      "required": ["id", "statement", "status", "root_cause_ids", "priority", "expected_outcome", "verification_method", "handoff_to"],
      "properties": {
        "id": {"type": "string", "pattern": "^PRESCRIPTION-[A-Za-z0-9._-]+$"},
        "statement": {"type": "string", "minLength": 1},
        "status": {"type": "string", "enum": ["INFERRED"]},
        "root_cause_ids": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "pattern": "^ROOT-[A-Za-z0-9._-]+$"},
          "uniqueItems": true
        },
        "priority": {"type": "string", "enum": ["P0", "P1", "P2"]},
        "expected_outcome": {"type": "string", "minLength": 1},
        "verification_method": {"type": "string", "minLength": 1},
        "handoff_to": {"type": "string", "enum": ["GEO"]}
      },
      "additionalProperties": false
    },
    "report_projection": {
      "type": "object",
      "required": [
        "source_contract_version",
        "status",
        "title",
        "customer_positioning",
        "ai_geo_status",
        "main_problems",
        "optimization_directions",
        "diagnostic_basis"
      ],
      "properties": {
        "source_contract_version": {"type": "string", "enum": ["1.0.0"]},
        "status": {"$ref": "#/definitions/status"},
        "title": {"type": "string", "enum": ["客户 GEO 快速诊断"]},
        "customer_positioning": {
          "type": "object",
          "required": ["one_sentence", "core_business", "main_customers", "main_scenarios", "source_ids"],
          "properties": {
            "one_sentence": {"type": "string", "minLength": 1, "maxLength": 160},
            "core_business": {"type": "array", "maxItems": 5, "items": {"type": "string"}},
            "main_customers": {"type": "array", "maxItems": 5, "items": {"type": "string"}},
            "main_scenarios": {"type": "array", "maxItems": 5, "items": {"type": "string"}},
            "source_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true}
          },
          "additionalProperties": false
        },
        "ai_geo_status": {
          "type": "object",
          "required": ["summary", "source_ids"],
          "properties": {
            "summary": {"type": "string", "minLength": 1, "maxLength": 500},
            "source_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true}
          },
          "additionalProperties": false
        },
        "main_problems": {
          "type": "array",
          "maxItems": 5,
          "items": {
            "type": "object",
            "required": ["problem", "source_ids"],
            "properties": {
              "problem": {"type": "string", "minLength": 1, "maxLength": 120},
              "source_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true}
            },
            "additionalProperties": false
          }
        },
        "optimization_directions": {
          "type": "object",
          "required": ["P0", "P1", "P2"],
          "properties": {
            "P0": {"$ref": "#/definitions/direction_list"},
            "P1": {"$ref": "#/definitions/direction_list"},
            "P2": {"$ref": "#/definitions/direction_list"}
          },
          "additionalProperties": false
        },
        "diagnostic_basis": {
          "type": "array",
          "minItems": 3,
          "maxItems": 5,
          "items": {
            "type": "object",
            "required": ["statement", "source_ids"],
            "properties": {
              "statement": {"type": "string", "minLength": 1, "maxLength": 180},
              "source_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true}
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "direction_list": {
      "type": "array",
      "maxItems": 3,
      "items": {
        "type": "object",
        "required": ["direction", "prescription_ids"],
        "properties": {
          "direction": {"type": "string", "minLength": 1, "maxLength": 160},
          "prescription_ids": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "pattern": "^PRESCRIPTION-[A-Za-z0-9._-]+$"},
            "uniqueItems": true
          }
        },
        "additionalProperties": false
      }
    }
  }
}
